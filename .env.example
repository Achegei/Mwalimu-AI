# ============================================================
# Mwalimu AI - Environment Configuration
# ============================================================
#
# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# Never commit the real .env file.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME="Mwalimu AI"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Generate a secure value for local/production use.
# Example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

SECRET_KEY=replace_with_secure_random_secret

# JWT configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

POSTGRES_DB=mwalimu_ai
POSTGRES_USER=mwalimu
POSTGRES_PASSWORD=change_me

# Used when running PostgreSQL through Docker Compose
DATABASE_URL=postgresql+asyncpg://mwalimu:change_me@db:5432/mwalimu_ai

# When running FastAPI directly on the host machine instead,
# the database host will normally be localhost:
#
# DATABASE_URL=postgresql+asyncpg://mwalimu:change_me@localhost:5432/mwalimu_ai


# ------------------------------------------------------------
# AI / LLM
# ------------------------------------------------------------

# Keep API credentials only in the real .env file.
OPENAI_API_KEY=your_openai_api_key_here

# Explicit model configuration prevents model names from
# being hard-coded throughout the application.
OPENAI_MODEL=replace_with_model_name


# ------------------------------------------------------------
# AI Tutor
# ------------------------------------------------------------

AI_TUTOR_ENABLED=true

# Controls the maximum amount of conversation history supplied
# to the tutor for a single request.
AI_TUTOR_HISTORY_LIMIT=10


# ------------------------------------------------------------
# Teacher AI Insights
# ------------------------------------------------------------

AI_TEACHER_INSIGHTS_ENABLED=true


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

LOG_LEVEL=INFO


# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------

TESTING=false